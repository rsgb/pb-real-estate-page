# Netlify redirects.
# Pre-rendered files (/pt/index.html, /en/market-brief/index.html, ...) are
# served before these rules, so only unmatched paths reach the list below.
# There is no SPA fallback on purpose: every real route is pre-rendered, so an
# unknown path 404s and Netlify serves dist/404.html.

# Language detection for the site root.
/    /pt    302    Language=pt
/    /es    302    Language=es
/    /fr    302    Language=fr
/    /en    302    Language=en
/    /pt    302
